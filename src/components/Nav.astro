---
import { siGithub } from 'simple-icons';
import { site } from '../lib/data';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { sections: { id: string; label: string }[] }
const { sections } = Astro.props;
const code = site.links.find((l) => l.kind === 'github' && l.url);
const docs = site.links.find((l) => l.kind === 'docs' && l.url);
const accent = site.titleAccent && site.title.endsWith(site.titleAccent) ? site.titleAccent : null;
const head = accent ? site.title.slice(0, -accent.length) : site.title;
---
<nav class="nav" aria-label="Sections">
  <div class="inner wrap">
    <a class="brand" href="#top">
      <Logo />
      <span>{head}{accent && <span class="accent">{accent}</span>}</span>
    </a>
    <ul class="sections">
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
    {docs && (
      <a class="docs" href={docs.url} aria-label="Docs">
        <Icon name="book" size={16} />
        <span>Docs</span>
      </a>
    )}
    {code && (
      <a class="code" href={code.url} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
        <span>Code</span>
      </a>
    )}
    <ThemeToggle />
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .inner { height: 3.5rem; display: flex; align-items: center; gap: 1.5rem; }
  .inner > :global(.theme) { margin-left: -0.75rem; }
  /* The mark's box has 1/8 side margin of its own, so the visible gap is ~8px, as in the lockup. */
  .brand { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.3rem; text-decoration: none; font-family: var(--sans); font-size: 1.125rem; font-weight: 800; letter-spacing: -0.02em; }
  .accent { color: var(--accent); }
  .sections { list-style: none; margin: 0 0 0 auto; padding: 0; display: flex; gap: 0.25rem; }
  .sections a {
    display: inline-flex; align-items: center; height: 2.25rem; padding-inline: 0.75rem; border-radius: var(--r-md);
    font-family: var(--sans); font-size: 0.9375rem; font-weight: 500; color: var(--ink-2); text-decoration: none;
    transition-property: background-color, color; transition-duration: 140ms;
  }
  @media (hover: hover) { .sections a:hover { color: var(--ink); background: var(--paper-2); } }
  .docs {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 2.25rem; padding-inline: 0.75rem; margin-right: -1rem; border-radius: var(--r-md);
    font-family: var(--sans); font-size: 0.9375rem; font-weight: 500; color: var(--ink); text-decoration: none;
    transition-property: background-color; transition-duration: 140ms;
  }
  @media (hover: hover) { .docs:hover { background: var(--paper-2); } }
  .code {
    display: inline-flex; align-items: center; gap: 0.45rem; height: 2.25rem; padding: 0 0.95rem 0 0.8rem;
    border-radius: 999px; background: #363636; color: #fff; text-decoration: none;
    font-family: var(--sans); font-size: 0.9375rem; font-weight: 500;
    transition-property: background-color, scale; transition-duration: 140ms;
  }
  .code svg { width: 1rem; height: 1rem; fill: currentColor; }
  @media (hover: hover) { .code:hover { background: #292929; } }
  .code:active { scale: 0.96; }
  @media (max-width: 820px) { .sections { display: none; } .docs { margin-left: auto; } }
  /* phones: the book alone, so the title stays on one line */
  @media (max-width: 560px) { .docs span { display: none; } .docs { padding-inline: 0.6rem; } }
  /* the narrowest phones (320 px): tighter gaps keep the theme toggle on screen */
  @media (max-width: 360px) { .inner { gap: 1rem; } }
</style>
