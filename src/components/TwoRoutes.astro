---
// Two programs for the same task, side by side: the strict-interface
// sessions of Astra and Opus 5.5 on multi-modal reaching. Each card plays one
// hidden seed in 3D and quotes three lines of the program, verbatim, by line
// number. "Open in the explorer" selects that session in the matrix below.
import { agent, agentById, policySource, viserPlayer } from '../lib/data';
import { highlightPython } from '../lib/highlight';
import { claude, openai } from '../lib/protocolMarks';

const TASK = 'reach_target_multi_modal';
const routes = [
  {
    session: 'astra-s2',
    mark: { d: openai, box: '0 0 90 90', fill: 'currentColor' },
    gist: 'Servoes in the image: it finds the red pixels in a wrist camera and nudges the arm toward them. No model of the camera or the arm.',
    steps: [
      { line: 13, label: 'Finds the target by colour' },
      { line: 54, label: 'Moves the shoulder in proportion to the pixel offset' },
      { line: 63, label: 'Extends the elbow once the target is centred' },
    ],
  },
  {
    session: 'opus-s3',
    mark: { d: claude, box: '0 0 24 24', fill: '#D97757' },
    gist: 'Rebuilds the tools the strict interface withholds: a camera model, the arm’s kinematics recalled from Unitree’s published description, and an IK solver.',
    steps: [
      { line: 21, label: 'Models the head camera it was never given' },
      { line: 120, label: 'Recalls the G1 shoulder offset from Unitree’s URDF' },
      { line: 170, label: 'Solves inverse kinematics numerically' },
    ],
  },
];

const task = agent.tasks.find((t) => t.task === TASK)!;
const cards = await Promise.all(routes.map(async (r) => {
  const s = task.sessions.find((x) => x.id === r.session)!;
  const a = agentById.get(s.agent)!;
  const src = policySource(s.files[0]).split('\n');
  const steps = await Promise.all(r.steps.map(async (st) => ({
    ...st,
    html: await highlightPython(src[st.line - 1].trim()),
  })));
  const rec = s.rollouts.find((x) => x.viser && s.episodes.find((e) => e.seed === x.seed)?.success)!;
  const v = viserPlayer(rec.viser!.file, rec.viser!.camera);
  return {
    ...r, s, a, steps,
    solved: s.episodes.filter((e) => e.success).length,
    player: v,
  };
}));
---
<div class="routes wrap" data-routes>
  <div class="cards">
    {cards.map((c) => (
      <article class="route">
        <div class="top">
          <svg class="mark" viewBox={c.mark.box} aria-hidden="true"><path d={c.mark.d} fill={c.mark.fill} fill-rule="evenodd" /></svg>
          <b>{c.a.model}</b>
          <span class="meta">session {c.s.session} · {c.s.lines} lines · solves {c.solved} of 100 hidden seeds</span>
        </div>
        <div class="stage">
          <iframe title={`3D replay of ${c.a.model} on multi-modal reaching`} data-client={c.player.client} data-recording={c.player.recording} data-query={c.player.query} allow="fullscreen"></iframe>
        </div>
        <p class="gist">{c.gist}</p>
        <ol class="steps">
          {c.steps.map((st) => (
            <li>
              <span class="label">{st.label}</span>
              <span class="code"><span class="ln">{st.line}</span><Fragment set:html={st.html} /></span>
            </li>
          ))}
        </ol>
        <button type="button" class="open" data-open-task={task.task} data-open-session={c.s.id}>Read the whole program</button>
      </article>
    ))}
  </div>
</div>

<script>
  import { followTheme, themed, whenScrollRests } from '../lib/viserTheme';
  import { attachFullscreen } from '../lib/fullscreen';
  followTheme();
  for (const root of document.querySelectorAll<HTMLElement>('[data-routes]')) {
    // The replays load as the cards come near, once the scroll pauses, and
    // one after the other: two players starting together stall the page.
    const frames = [...root.querySelectorAll<HTMLIFrameElement>('iframe[data-client]')];
    root.querySelectorAll<HTMLElement>('.stage').forEach(attachFullscreen);
    frames.forEach((f) => {
      const { client, recording, query } = f.dataset;
      f.dataset.viser = `${client}?playbackPath=${encodeURIComponent(new URL(recording!, location.href).href)}${query}`;
    });
    const start = (i: number) => {
      const f = frames[i];
      if (!f) return;
      f.addEventListener('load', () => setTimeout(() => whenScrollRests(() => start(i + 1)), 1200), { once: true });
      f.src = themed(f.dataset.viser!);
    };
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      whenScrollRests(() => start(0));
    }, { rootMargin: '600px' });
    io.observe(root);

    root.querySelectorAll<HTMLButtonElement>('[data-open-task]').forEach((b) => b.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('explorer:open', { detail: { task: b.dataset.openTask, session: b.dataset.openSession } }));
    }));
  }
</script>

<style>
  .routes { margin-bottom: clamp(3rem, 7vw, 4.5rem); font-family: var(--sans); }

  /* Two plain columns with a hairline between them; no card chrome. */
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .route { display: flex; flex-direction: column; min-width: 0; padding: 0 clamp(1rem, 3vw, 2rem); }
  .route:first-child { padding-left: 0; border-right: 1px solid var(--rule); }
  .route:last-child { padding-right: 0; }
  .top { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 0.55rem; margin-bottom: 0.8rem; }
  .mark { width: 1.1rem; height: 1.1rem; flex: none; color: var(--ink); }
  .top b { font-size: 0.9375rem; font-weight: 650; color: var(--ink); }
  .meta { font-size: 0.8125rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  .stage { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; background: #0b0c0e; }
  .stage iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  /* Not yet loaded (it waits for the scroll to rest): an empty iframe paints white. */
  .stage iframe:not([src]) { visibility: hidden; }

  .gist { margin: 1rem 0 0.9rem; font-size: 0.9375rem; line-height: 1.55; color: var(--ink-2); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; counter-reset: step; }
  .steps li { display: grid; gap: 0.25rem; counter-increment: step; }
  .label { font-size: 0.8125rem; color: var(--ink-2); }
  .label::before { content: counter(step) '. '; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .code { display: flex; align-items: baseline; gap: 0.7rem; min-width: 0; overflow-x: auto; padding-bottom: 0.1rem; }
  .ln { flex: none; min-width: 1.6rem; text-align: right; font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .code :global(pre) { margin: 0; padding: 0; background: transparent !important; font-family: var(--mono); font-size: 0.75rem; line-height: 1.5; white-space: pre; }
  .open {
    align-self: flex-start; margin-top: 1rem; padding: 0; border: 0; background: none; cursor: pointer;
    font: inherit; font-size: 0.8125rem; font-weight: 600; color: var(--accent-ink);
    text-decoration: underline; text-decoration-color: color-mix(in oklab, currentColor 35%, transparent); text-underline-offset: 3px;
  }
  @media (hover: hover) { .open:hover { text-decoration-color: currentColor; } }
  .open:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

  @media (max-width: 820px) {
    .cards { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .route, .route:first-child, .route:last-child { padding: 0; border: 0; }
  }

  /* Phones: nothing under ~12.5px. */
  @media (max-width: 640px) {
    .ln { font-size: 0.75rem; }
    .code :global(pre) { font-size: 0.78125rem; }
    .label, .meta { font-size: 0.875rem; }
  }
</style>
