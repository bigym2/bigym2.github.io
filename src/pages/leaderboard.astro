---
// The old leaderboard address, which posts link to: it now opens the board on the home page.
import Base from '../layouts/Base.astro';
import { asset } from '../lib/data';
const to = asset('/#board');
---
<Base title="Leaderboard" redirect={to}>
  <p style="font-family: var(--sans); padding: 2rem;">The leaderboard has moved to the <a href={to}>home page</a>.</p>
  <script is:inline define:vars={{ to }}>location.replace(to);</script>
</Base>
